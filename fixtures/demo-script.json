  "source_paragraphs": [
    { "id": "ch1_p1_df6f5806", "chapter_id": "ch1", "paragraph_index": 1, "text_preview": "林深在雾港的旧码头停下脚步，海风把三年前那场沉船的咸味重新卷回他的喉咙。", "hash": "df6f5806" },
    { "id": "ch1_p2_cfaa58f1", "chapter_id": "ch1", "paragraph_index": 2, "text_preview": "灯塔顶端忽明忽暗，苏晚站在锈门后，没有问他为什么还活着。", "hash": "cfaa58f1" },
    { "id": "ch2_p1_acbae21c", "chapter_id": "ch2", "paragraph_index": 1, "text_preview": "苏晚把一只旧怀表推到林深面前，表盖内侧刻着父亲失踪前留下的坐标。", "hash": "acbae21c" },
    { "id": "ch2_p2_87f95f45", "chapter_id": "ch2", "paragraph_index": 2, "text_preview": "码头工头周砚带人封住仓库，警告他们别再翻那夜的货单。", "hash": "87f95f45" },
    { "id": "ch3_p1_cbe21379", "chapter_id": "ch3", "paragraph_index": 1, "text_preview": "暴雨压低了海面，林深在仓库暗格里找到了父亲写给苏晚的信。", "hash": "cbe21379" },
    { "id": "ch3_p2_3d978716", "chapter_id": "ch3", "paragraph_index": 2, "text_preview": "他终于明白真相会毁掉雾港，也会救回被周砚控制的船员家属。", "hash": "3d978716" }
  ],
